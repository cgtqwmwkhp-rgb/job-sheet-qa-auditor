{
  "$schema": "./thresholds.schema.json",
  "version": "2.1.0",
  "description": "Parity threshold governance - Wave-4 A3 PR subset \u226515 + field-F1 SLO hooks",
  "thresholds": {
    "overall": {
      "minPassRate": 1.0,
      "maxWorseCount": 0,
      "maxNewFailures": 0,
      "description": "Positive suite must maintain 100% pass rate with no regressions"
    },
    "bySeverity": {
      "S0": {
        "minPassRate": 1.0,
        "maxWorseCount": 0,
        "description": "Critical fields must have 100% pass rate in positive suite"
      },
      "S1": {
        "minPassRate": 1.0,
        "maxWorseCount": 0,
        "description": "Major fields must have 100% pass rate in positive suite"
      },
      "S2": {
        "minPassRate": 1.0,
        "maxWorseCount": 0,
        "description": "Minor fields must have 100% pass rate in positive suite"
      },
      "S3": {
        "minPassRate": 1.0,
        "maxWorseCount": 0,
        "description": "Info fields must have 100% pass rate in positive suite"
      }
    }
  },
  "negativeSuite": {
    "description": "Negative suite validates that expected failures are correctly detected",
    "requireAllExpectedFailures": true,
    "allowUnexpectedFailures": false
  },
  "alerts": {
    "warnOnImprovement": true,
    "warnOnNewFields": true,
    "failOnRegression": true,
    "failOnMissingBaseline": false
  },
  "ci": {
    "prSubsetDocIds": [
      "doc-001",
      "doc-003",
      "doc-009",
      "doc-010",
      "doc-011",
      "doc-013",
      "doc-014",
      "doc-016",
      "doc-017",
      "doc-019",
      "doc-020",
      "doc-021",
      "doc-023",
      "doc-024",
      "doc-026"
    ],
    "nightlyFullSuite": true,
    "artifactRetentionDays": 30,
    "summaryFormat": "markdown"
  },
  "governance": {
    "requireApprovalForThresholdChange": true,
    "approvers": ["@qa-team", "@tech-lead"],
    "changeLogRequired": true
  },
  "canonicalReasonCodes": [
    "MISSING_FIELD",
    "INVALID_FORMAT",
    "OUT_OF_POLICY",
    "LOW_CONFIDENCE",
    "CONFLICT",
    "SPEC_GAP",
    "OCR_FAILURE",
    "PIPELINE_ERROR"
  ],
  "canonicalStatuses": ["PASS", "FAIL", "REVIEW_QUEUE"],
  "semanticRules": {
    "PASS_REQUIRES_NULL_REASON_CODE": true,
    "description": "When status is PASS, reasonCode must be null/absent. VALID is NOT a reason code."
  },
  "fieldF1": {
    "minSamplesRequired": 50,
    "minExactMatchF1": 0.9,
    "fixturePath": "parity/fixtures/field-f1-labelled.json"
  },
  "sampling": {
    "maxPassSampleMissRate": 0.05,
    "minPassSamplesRequired": 30
  },
  "attribution": {
    "maxUnattributedRate": 0.05,
    "minSheetsRequired": 50
  }
}
